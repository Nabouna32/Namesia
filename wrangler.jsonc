{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namesia",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "upload_source_maps": true,
  "compatibility_date": "2026-11-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NAMESIA_DEPLOYMENT_ENVIRONMENT": "production"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "find_additional_modules": true,
  "base_dir": ".",
  "preserve_file_names": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "assets/fonts/Roboto-Regular.ttf.base64"
      ],
      "fallthrough": true
    }
  ]
}
